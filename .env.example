PUID=1000
PGID=1000
TZ=UTC

NAVIDROME_PORT=4533
SYNC_INTERVAL_MINUTES=5
LOCAL_READY_AGE_SECONDS=30

YT_PLAYLIST_URL=
YT_PLAYLIST_ITEMS=
YT_AUDIO_FORMAT=mp3
YT_AUDIO_QUALITY=0
YT_BREAK_ON_EXISTING=true
YT_SKIP_VIDEO_IDS=
LOCAL_WATCH_DIRS=

# Use one of the cookie options only if the playlist ever needs login.
YT_COOKIES_FROM_BROWSER=
YT_COOKIES_FILE=

# Optional. Enables AcoustID/chroma fingerprint matching in beets.
ACOUSTID_API_KEY=

# Enables genre tagging and external radio from genres, favourites or playlists, with Save downloads.
# Optional: create your own free Last.fm API key.
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# How many top genres to render as auto playlists. Set to 0 to disable.
AUTO_PLAYLIST_TOP_GENRES=40
AUTO_PLAYLIST_MIN_TRACKS=5

# Requires the configured AudioMuse service and state/sonic/credentials.json.
# Publishes balanced genre playlists directly to Navidrome instead of legacy M3U lists.
CURATED_PLAYLISTS=false

# AudioMuse sonic analysis for Instant Mix / Feishin Auto DJ. Secrets stay in state/sonic/.
AUDIOMUSE_URL=http://127.0.0.1:8000
NAVIDROME_URL=http://127.0.0.1:4533

# Feishin web player defaults (port, Navidrome URL, Auto DJ, theme) live in config/feishin.env.
# Copy config/feishin.env.example for fresh setup; FEISHIN_ASSETS selects the built frontend.

# PUBLIC_PLAYER_URL in config/feishin.env sets the private SomaFM relay base URL.
# The relay signing key is generated in protected state/discovery/relay.key.

# Optional Amperfy companion configuration lives in config/capture.env.
# Copy config/capture.env.example and run scripts/run-capture.py.
# MUSICA_CAPTURE_PORT=9181
# MUSICA_CAPTURE_PUBLIC_URL=https://your-private-host.example
# MUSICA_LIBRARY_PUBLIC_URL=https://your-navidrome-host.example
# MUSICA_CAPTURE_TOKEN_FILE=/path/to/protected/state/capture/token

# Enable native discovery stations in config/capture.env.
# MUSICA_NATIVE_RADIOS=false
