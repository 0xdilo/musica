@@ -0,0 +1,63 @@
+import { describe, expect, test } from 'bun:test';
+
+import {
+    discoveriesSchema,
+    preferencesSchema,
+    previewSchema,
+    radioSchema,
+} from '../../api/musica/schemas';
+
+// Broken server responses must not enter the queue or render an exclusion as HTML.
+describe('discovery responses', () => {
+    test('rejects untrusted preview URLs and unknown acquisition states', () => {
+        expect(previewSchema.safeParse({ audio_url: 'https://evil.example' }).success).toBe(false);
+        expect(
+            previewSchema.safeParse({
+                audio_url: `/preview/${'a'.repeat(32)}/1793190000/${'b'.repeat(64)}.mp3`,
+            }).success,
+        ).toBe(true);
+        const track = {
+            artist: 'Artist',
+            error: '',
+            id: 'a'.repeat(32),
+            reason: 'Seed',
+            song_id: '',
+            status: 'queued',
+            title: 'Song',
+        };
+        expect(discoveriesSchema.safeParse({ tracks: [track] }).success).toBe(true);
+        expect(
+            discoveriesSchema.safeParse({ tracks: [{ ...track, status: 'done-maybe' }] }).success,
+        ).toBe(false);
+    });
+    test('requires an explicit ordered list of valid library IDs', () => {
+        expect(
+            radioSchema.safeParse({ description: 'Radio', ids: ['123abc'], pool: 10 }).success,
+        ).toBe(true);
+        expect(
+            radioSchema.safeParse({
+                description: 'Radio',
+                ids: ['../stream?token=secret'],
+                pool: 10,
+            }).success,
+        ).toBe(false);
+        expect(
+            radioSchema.safeParse({ description: 'Radio', ids: Array(31).fill('123'), pool: 50 })
+                .success,
+        ).toBe(false);
+    });
+    test('rejects invalid exclusion shapes', () => {
+        expect(preferencesSchema.safeParse({ artists: [], tracks: {} }).success).toBe(false);
+        expect(
+            preferencesSchema.parse({ artists: { artist: 'Artist' }, tracks: {} }).artists.artist,
+        ).toBe('Artist');
+    });
+});
+
+test('additional languages load on demand without blocking Italian startup', async () => {
+    const { extraLocales } = await import('../../../i18n/extra-locales');
+    expect(extraLocales.it).toBeUndefined();
+    expect(extraLocales.en).toBeUndefined();
+    const french = await extraLocales.fr();
+    expect(Object.keys(french.default).length).toBeGreaterThan(10);
+});
