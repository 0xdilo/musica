@@ -0,0 +1,61 @@
+import { startDiscoveryRadio, useDiscoveryRadio } from './discovery-radio';
+
+import { type DiscoveryContext } from '/@/renderer/api/musica/schemas';
+import { useRadioStore } from '/@/renderer/features/radio/hooks/use-radio-player';
+import { useCurrentServerId } from '/@/renderer/store';
+import { Button } from '/@/shared/components/button/button';
+import { Icon } from '/@/shared/components/icon/icon';
+
+export const RadioSourceButton = ({
+    context,
+    disabled = false,
+    label = 'Scopri musica simile',
+    large = false,
+}: {
+    context: DiscoveryContext;
+    disabled?: boolean;
+    label?: string;
+    large?: boolean;
+}) => {
+    const serverId = useCurrentServerId() || '';
+    const state = useDiscoveryRadio();
+    const playing = useRadioStore((radio) => radio.isPlaying);
+    const matches =
+        state.active &&
+        state.context.mode === context.mode &&
+        state.context.value === context.value &&
+        (state.context.listening || 'discovery') === (context.listening || 'discovery');
+    return (
+        <Button
+            disabled={disabled}
+            leftSection={
+                <Icon
+                    icon={
+                        matches && state.current && !state.finished
+                            ? playing
+                                ? 'mediaPause'
+                                : 'mediaPlay'
+                            : 'mediaPlay'
+                    }
+                    size="lg"
+                />
+            }
+            loading={matches && state.loading}
+            onClick={() => {
+                if (matches && state.current && !state.finished) {
+                    const controls = useRadioStore.getState().actions;
+                    if (playing) controls.pause();
+                    else controls.play();
+                } else void startDiscoveryRadio(serverId, context);
+            }}
+            size={large ? 'lg' : 'sm'}
+            variant="filled"
+        >
+            {matches && state.current && !state.finished
+                ? playing
+                    ? 'Pausa'
+                    : 'Riprendi'
+                : label.replace(/^▶ /, '')}
+        </Button>
+    );
+};
