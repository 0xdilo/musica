+                                aria-label="Radio live"
+                                component={Link}
+                                icon="radio"
+                                size="lg"
+                                to={AppRoute.RADIO}
+                                tooltip={{ label: 'Radio live' }}
+                                variant="subtle"
+                            />
+                            <ActionIcon
+                                aria-label="Cerca musica"
+                                component={Link}
+                                icon="search"
+                                size="lg"
+                                to={generatePath(AppRoute.SEARCH, { itemType: LibraryItem.SONG })}
+                                tooltip={{ label: 'Cerca musica' }}
+                                variant="subtle"
+                            />
+                        </Group>
+                    </header>
+                    <Tabs defaultValue="discover" h="auto">
+                        <Tabs.List className={styles.exploreTabs}>
+                            <Tabs.Tab value="discover">Nuova musica</Tabs.Tab>
+                            <Tabs.Tab value="library">La tua libreria</Tabs.Tab>
+                        </Tabs.List>
+                        <Tabs.Panel value="discover">
+                            <NewMusic serverId={serverId} />
+                        </Tabs.Panel>
+                        <Tabs.Panel value="library">
+                            <form
+                                className={styles.search}
+                                onSubmit={(event) => {
+                                    event.preventDefault();
+                                    void search('text');
+                                }}
+                            >
+                                <TextInput
+                                    aria-label="Descrivi la musica"
+                                    maxLength={240}
+                                    onChange={(event) => setQuery(event.currentTarget.value)}
+                                    placeholder="Artista, genere o atmosfera"
+                                    value={query}
+                                />
+                                <Button
+                                    disabled={query.trim().length < 2}
+                                    leftSection={<Icon icon="search" />}
+                                    loading={loading}
+                                    type="submit"
+                                    variant="filled"
+                                >
+                                    Cerca
+                                </Button>
+                            </form>
+                            <div className={styles.libraryActions}>
+                                <Button
+                                    leftSection={<Icon icon="favorite" />}
+                                    onClick={() => void search('personal')}
+                                    variant="subtle"
+                                >
+                                    Dai preferiti
+                                </Button>
+                                <Button
+                                    leftSection={<Icon icon="lastPlayed" />}
+                                    onClick={() => void search('forgotten')}
+                                    variant="subtle"
+                                >
+                                    Da riscoprire
+                                </Button>
+                                <Select
+                                    aria-label="Genere nella libreria"
+                                    clearable
+                                    data={
+                                        overview.data?.genres.map((genre) => ({
+                                            label: `${genre.name} · ${genre.count}`,
+                                            value: genre.name,
+                                        })) || []
+                                    }
+                                    onChange={(value) => {
+                                        if (value) void search('genre', value);
+                                    }}
+                                    placeholder={
+                                        overview.isPending ? 'Caricamento generi…' : 'Genere…'
+                                    }
+                                    searchable
+                                    value={lastRequest?.mode === 'genre' ? lastRequest.query : null}
+                                />
+                                {overview.isError && (
+                                    <Button
+                                        onClick={() => void overview.refetch()}
+                                        variant="subtle"
+                                    >
+                                        Ricarica generi
+                                    </Button>
+                                )}
+                            </div>
+                            <details className={styles.libraryOptions}>
+                                <summary>Opzioni</summary>
+                                <div className={styles.options}>
