+import { Link } from 'react-router';
+
+import { startDiscoveryRadio, useDiscoveryRadio } from './discovery-radio';
+import styles from './explore.module.css';
+
+import { useRadioStore } from '/@/renderer/features/radio/hooks/use-radio-player';
+import { AppRoute } from '/@/renderer/router/routes';
+import { useCurrentServerId } from '/@/renderer/store';
+import { Button } from '/@/shared/components/button/button';
+import { Group } from '/@/shared/components/group/group';
+import { Icon } from '/@/shared/components/icon/icon';
+
+export const DiscoveryHero = () => {
+    const serverId = useCurrentServerId() || '';
+    const { active, context, current, finished, loading } = useDiscoveryRadio();
+    const playing = useRadioStore((state) => state.isPlaying);
+    return (
+        <section className={styles.homeHero}>
+            <div>
+                <p className={styles.eyebrow}>MUSICA, SENZA PREPARATIVI</p>
+                <h2>Cosa vuoi ascoltare?</h2>
+                <p>Una radio dai tuoi gusti, un genere o il suono che hai in testa.</p>
+            </div>
+            <Group gap="sm">
+                <Button
+                    leftSection={
+                        <Icon
+                            icon={
+                                active && current && !finished
+                                    ? playing
+                                        ? 'mediaPause'
+                                        : 'mediaPlay'
+                                    : 'related'
+                            }
+                            size="lg"
+                        />
+                    }
+                    loading={loading}
+                    onClick={() => {
+                        if (active && current && !finished) {
+                            const controls = useRadioStore.getState().actions;
+                            if (playing) controls.pause();
+                            else controls.play();
+                        } else void startDiscoveryRadio(serverId, finished ? context : undefined);
+                    }}
+                    variant="filled"
+                >
+                    {active && current && !finished
+                        ? playing
+                            ? 'Pausa radio'
+                            : 'Riprendi radio'
+                        : finished
+                          ? 'Riascolta playlist'
+                          : 'Scopri nuova musica'}
+                </Button>
+                <Button
+                    component={Link}
+                    leftSection={<Icon icon="search" />}
+                    to={AppRoute.EXPLORE}
+                    variant="light"
+                >
+                    Esplora
+                </Button>
+                <Button
+                    component={Link}
+                    leftSection={<Icon icon="radio" />}
+                    to={AppRoute.RADIO}
+                    variant="subtle"
+                >
+                    Radio dal vivo
+                </Button>
+            </Group>
+        </section>
+    );
+};
diff --git a/src/renderer/features/explore/discovery-radio-player.tsx b/src/renderer/features/explore/discovery-radio-player.tsx
new file mode 100644
index 0000000..c207266
--- /dev/null
+++ b/src/renderer/features/explore/discovery-radio-player.tsx
@@ -0,0 +1,245 @@
+import { useEffect, useRef } from 'react';
+
+import {
+    abandonDiscoveryRadio,
+    discoveryLabel,
+    nextDiscoveryTrack,
+    saveCurrentDiscovery,
+    startDiscoveryRadio,
+    stopDiscoveryRadio,
+    useDiscoveryRadio,
+} from './discovery-radio';
+import styles from './explore.module.css';
+
+import { api } from '/@/renderer/api';
+import { usePlayer } from '/@/renderer/features/player/context/player-context';
+import { checkScrobbleConditions } from '/@/renderer/features/player/hooks/use-scrobble';
+import { useSendScrobble } from '/@/renderer/features/player/mutations/scrobble-mutation';
+import { useRadioStore } from '/@/renderer/features/radio/hooks/use-radio-player';
+import { useAppStore, usePlaybackSettings, usePlayerVolume } from '/@/renderer/store';
+import { Button } from '/@/shared/components/button/button';
+import { Icon } from '/@/shared/components/icon/icon';
+import { toast } from '/@/shared/components/toast/toast';
+
+export const DiscoveryRadioHook = () => {
+    const { active, current, elapsed, serverId } = useDiscoveryRadio();
+    const playing = useRadioStore((state) => state.isPlaying);
+    const privateMode = useAppStore((state) => state.privateMode);
+    const scrobble = usePlaybackSettings().scrobble;
+    const { mutate: sendScrobble } = useSendScrobble();
+    const listened = useRef({ current, position: 0, seconds: 0, submitted: false });
+    useEffect(() => {
+        if (listened.current.current !== current)
+            listened.current = { current, position: elapsed, seconds: 0, submitted: false };
+        const sample = listened.current;
+        const delta = elapsed - sample.position;
+        sample.position = elapsed;
+        if (
+            !active ||
+            current?.libraryIndex === undefined ||
+            !playing ||
+            privateMode ||
+            !scrobble.enabled
+        )
+            return;
+        if (delta > 0 && delta <= 5) sample.seconds += delta;
+        if (
+            sample.submitted ||
+            !checkScrobbleConditions({
+                minimumMode: scrobble.minimumMode,
+                scrobbleAtDurationMs: scrobble.scrobbleAtDuration * 1000,
+                scrobbleAtPercentage: scrobble.scrobbleAtPercentage,
+                songCompletedDurationMs: sample.seconds * 1000,
+                songDurationMs: current.duration * 1000,
+            })
+        )
+            return;
+        sample.submitted = true;
+        sendScrobble(
+            {
+                apiClientProps: { serverId },
+                query: {
+                    id: current.track.song_id,
+                    mediaType: 'song',
+                    playbackRate: 1,
+                    submission: true,
+                },
+            },
+            {
+                onError: () =>
+                    toast.error({
+                        message:
+                            'Non riesco a registrare questo ascolto. Controlla la connessione.',
+                    }),
+            },
+        );
+    }, [active, current, elapsed, playing, privateMode, scrobble, sendScrobble, serverId]);
+    const currentId = current?.track.id;
+    const currentStatus = current?.track.status;
+    useEffect(
+        () =>
+            useRadioStore.subscribe((radio) => {
+                const state = useDiscoveryRadio.getState();
+                if (
+                    state.active &&
+                    state.current &&
+                    !state.loading &&
+                    radio.currentStreamUrl !== state.current.audio_url
+                ) {
+                    abandonDiscoveryRadio();
+                }
+            }),
+        [],
+    );
+
+    useEffect(() => {
+        if (
+            !active ||
+            !currentId ||
+            !currentStatus ||
+            !['downloading', 'importing', 'matching', 'queued'].includes(currentStatus)
+        )
+            return;
+        let disposed = false;
+        const check = async () => {
+            try {
+                const response = await api.musica.savedDiscoveries(serverId);
+                const saved = response.tracks.find((track) => track.id === currentId);
+                const state = useDiscoveryRadio.getState();
+                if (!disposed && saved && state.current?.track.id === saved.id) {
+                    useDiscoveryRadio.setState({ current: { ...state.current, track: saved } });
+                }
+            } catch (failure) {
+                if (!disposed)
+                    useDiscoveryRadio.setState({
+                        error:
+                            failure instanceof Error
+                                ? failure.message
+                                : 'Non riesco a verificare il salvataggio.',
+                    });
+            }
+        };
+        const interval = window.setInterval(() => void check(), 3000);
+        return () => {
+            disposed = true;
+            window.clearInterval(interval);
+        };
+    }, [active, currentId, currentStatus, serverId]);
+    return null;
+};
+
+export const DiscoveryRadioBar = () => {
+    const { context, current, elapsed, error, finished, loading, savingId, serverId } =
+        useDiscoveryRadio();
+    const isPlaying = useRadioStore((state) => state.isPlaying);
+    const controls = useRadioStore((state) => state.actions);
+    const volume = usePlayerVolume();
+    const player = usePlayer();
+    const track = current?.track;
+    const message = track?.error || error;
+    const saved = track?.status === 'ready';
+    const saving = Boolean(
+        track && ['downloading', 'importing', 'matching', 'queued'].includes(track.status),
+    );
+    return (
+        <section aria-label="Player nuova musica" className={styles.discoveryPlayer}>
+            <div className={styles.discoveryNow}>
+                <strong>{track?.title || `Radio · ${context.label}`}</strong>
+                <span>
+                    {track?.artist || (loading ? 'Preparo il primo brano…' : 'Premi Riprova')}
+                </span>
+                <small role={message ? 'alert' : 'status'}>
+                    {message ||
+                        (finished
+                            ? 'Playlist completata'
+                            : loading
+                              ? current
+                                  ? 'Preparo il prossimo…'
+                                  : 'Preparo il primo audio…'
+                              : `${discoveryLabel(context)} · ${context.label}${context.listening === 'mix' ? (current?.libraryIndex !== undefined ? ' · Dalla playlist' : ' · Nuova scoperta') : ''}`)}
+                </small>
+            </div>
+            <div className={styles.discoveryTransport}>
+                <Button
+                    aria-label={
+                        finished
+                            ? 'Riascolta playlist'
+                            : isPlaying
+                              ? 'Pausa radio nuova musica'
+                              : 'Riprendi radio nuova musica'
+                    }
+                    disabled={!current}
+                    onClick={() =>
+                        finished
+                            ? void startDiscoveryRadio(serverId, context)
+                            : isPlaying
+                              ? controls.pause()
+                              : controls.play()
+                    }
+                    size="sm"
+                >
+                    <Icon icon={isPlaying ? 'mediaPause' : 'mediaPlay'} size="lg" />
+                </Button>
+                <Button
+                    aria-label={error ? 'Riprova riproduzione' : 'Prossimo brano'}
+                    disabled={finished}
+                    loading={loading}
+                    onClick={() =>
+                        current
+                            ? void nextDiscoveryTrack()
+                            : void startDiscoveryRadio(serverId, context)
+                    }
+                    size="sm"
+                >
+                    <Icon icon={error ? 'refresh' : 'mediaNext'} size="lg" />
+                    <span className={styles.transportLabel}>{error ? 'Riprova' : 'Avanti'}</span>
+                </Button>
+                <Button
+                    aria-label={track?.status === 'failed' ? 'Riprova salvataggio' : undefined}
+                    classNames={{ section: styles.saveSection }}
+                    disabled={!track || saved || saving}
+                    leftSection={<Icon icon={saved ? 'check' : 'plus'} size="md" />}
+                    loading={Boolean(track && savingId === track.id)}
+                    onClick={() => void saveCurrentDiscovery()}
+                    size="sm"
+                    variant="filled"
+                >
+                    {saved
+                        ? current?.libraryIndex !== undefined
+                            ? 'In libreria'
+                            : 'Salvato'
+                        : saving
+                          ? 'Salvo…'
+                          : track?.status === 'failed'
+                            ? 'Riprova'
+                            : 'Salva'}
+                </Button>
+                <label className={styles.discoveryVolume}>
+                    Volume
+                    <input
+                        aria-label="Volume radio nuova musica"
+                        max={100}
+                        min={0}
+                        onChange={(event) => player.setVolume(Number(event.currentTarget.value))}
+                        type="range"
+                        value={volume}
+                    />
+                </label>
+                <Button
+                    aria-label="Ferma radio nuova musica"
+                    onClick={stopDiscoveryRadio}
+                    size="sm"
+                    variant="subtle"
+                >
+                    <Icon icon="x" size="lg" />
+                </Button>
+            </div>
+            <progress
+                aria-label="Avanzamento brano nuovo"
+                className={styles.discoveryProgress}
+                max={current?.duration || 1}
+                value={elapsed}
+            />
+        </section>
+    );
+};
