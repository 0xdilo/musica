@@ -0,0 +1,74 @@
+import { useState } from 'react';
+
+import { useDiscoveryRadio } from './discovery-radio';
+import styles from './playlist-listening.module.css';
+import { RadioSourceButton } from './radio-source-button';
+
+import { type DiscoveryContext, type ListeningMode } from '/@/renderer/api/musica/schemas';
+import { Button } from '/@/shared/components/button/button';
+import { DropdownMenu } from '/@/shared/components/dropdown-menu/dropdown-menu';
+import { type AppIconSelection, Icon } from '/@/shared/components/icon/icon';
+
+const choices: { icon: AppIconSelection; label: string; mode: ListeningMode }[] = [
+    { icon: 'playlist', label: 'Solo playlist', mode: 'library' },
+    { icon: 'related', label: 'Solo simili', mode: 'discovery' },
+    { icon: 'mediaShuffle', label: 'Playlist + simili', mode: 'mix' },
+];
+
+export const ListeningChoices = ({
+    onChange,
+    value,
+}: {
+    onChange: (mode: ListeningMode) => void;
+    value: ListeningMode;
+}) => (
+    <DropdownMenu position="bottom-start">
+        <DropdownMenu.Target>
+            <Button
+                aria-label={`Modalità di ascolto: ${choices.find((choice) => choice.mode === value)?.label}`}
+                rightSection={<Icon icon="dropdown" size="sm" />}
+                size="sm"
+                variant="subtle"
+            >
+                {choices.find((choice) => choice.mode === value)?.label}
+            </Button>
+        </DropdownMenu.Target>
+        <DropdownMenu.Dropdown>
+            {choices.map((choice) => (
+                <DropdownMenu.Item
+                    isSelected={value === choice.mode}
+                    key={choice.mode}
+                    leftSection={<Icon icon={choice.icon} />}
+                    onClick={() => onChange(choice.mode)}
+                >
+                    {choice.label}
+                </DropdownMenu.Item>
+            ))}
+        </DropdownMenu.Dropdown>
+    </DropdownMenu>
+);
+
+export const PlaylistListening = ({
+    context,
+    disabled,
+}: {
+    context: DiscoveryContext;
+    disabled: boolean;
+}) => {
+    const current = useDiscoveryRadio((state) => state.context);
+    const [mode, setMode] = useState<ListeningMode>(
+        current.mode === 'playlist' && current.value === context.value
+            ? current.listening || 'discovery'
+            : 'library',
+    );
+    return (
+        <section aria-label="Ascolta questa playlist" className={styles.toolbar}>
+            <RadioSourceButton
+                context={{ ...context, listening: mode }}
+                disabled={disabled}
+                label="Riproduci"
+            />
+            <ListeningChoices onChange={setMode} value={mode} />
+        </section>
+    );
+};
