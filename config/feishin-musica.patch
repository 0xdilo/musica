+                                                    <button
+                                                        aria-label={`Ascolta ${song.name}`}
+                                                        className={styles.trackPlay}
+                                                        onClick={() =>
+                                                            play(result.songs.slice(index))
+                                                        }
+                                                        type="button"
+                                                    >
+                                                        <div className={styles.cover}>
+                                                            <ItemImage
+                                                                id={song.imageId}
+                                                                itemType={LibraryItem.SONG}
+                                                                serverId={serverId}
+                                                                type="table"
+                                                            />
+                                                        </div>
+                                                        <div className={styles.trackText}>
+                                                            <strong>{song.name}</strong>
+                                                            <span>{song.artistName}</span>
+                                                        </div>
+                                                    </button>
+                                                    <details className={styles.trackMenu}>
+                                                        <summary
+                                                            aria-label={`Opzioni per ${song.name}`}
+                                                        >
+                                                            •••
+                                                        </summary>
+                                                        <div>
+                                                            <button
+                                                                disabled={feedbackPending}
+                                                                onClick={() =>
+                                                                    void exclude('tracks', song)
+                                                                }
+                                                                type="button"
+                                                            >
+                                                                Non proporre questo brano
+                                                            </button>
+                                                            <button
+                                                                disabled={feedbackPending}
+                                                                onClick={() =>
+                                                                    void exclude('artists', song)
+                                                                }
+                                                                type="button"
+                                                            >
+                                                                Non proporre questo artista
+                                                            </button>
+                                                        </div>
+                                                    </details>
+                                                </li>
+                                            ))}
+                                        </ol>
+                                    </>
+                                )}
+                            </section>
+                            {exclusions &&
+                                Object.values(exclusions).some(
+                                    (items) => Object.keys(items).length > 0,
+                                ) && (
+                                    <details className={styles.exclusions}>
+                                        <summary>Esclusioni dai suggerimenti</summary>
+                                        <p>
+                                            Valgono per Esplora e per le playlist automatiche, su
+                                            tutti i tuoi dispositivi.
+                                        </p>
+                                        {(['tracks', 'artists'] as const).flatMap((kind) =>
+                                            Object.entries(exclusions[kind]).map(([key, label]) => (
+                                                <div key={`${kind}:${key}`}>
+                                                    <span>{label}</span>
+                                                    <Button
+                                                        disabled={feedbackPending}
+                                                        onClick={() => void restore(kind, key)}
