diff --git a/src/renderer/features/explore/discovery-radio.ts b/src/renderer/features/explore/discovery-radio.ts
new file mode 100644
index 0000000..a778467
--- /dev/null
+++ b/src/renderer/features/explore/discovery-radio.ts
@@ -0,0 +1,252 @@
+import { create } from 'zustand';
+
+import { api } from '/@/renderer/api';
+import { type DiscoveryContext, type DiscoveryRadioTrack } from '/@/renderer/api/musica/schemas';
+import { useRadioStore } from '/@/renderer/features/radio/hooks/use-radio-player';
+import { type Song } from '/@/shared/types/domain-types';
+
+export type PreparedRadioTrack = DiscoveryRadioTrack & { libraryIndex?: number };
+
+type DiscoveryRadioState = {
+    active: boolean;
+    context: DiscoveryContext;
+    current: null | PreparedRadioTrack;
+    elapsed: number;
+    error: string;
+    finished: boolean;
+    libraryIndex: number;
+    librarySongs: Song[];
+    loading: boolean;
+    next: null | PreparedRadioTrack;
+    preparing: boolean;
+    savingId: string;
+    seen: string[];
+    serverId: string;
+};
+
+const initialState: DiscoveryRadioState = {
+    active: false,
+    context: { label: 'Per te', mode: 'personal', value: '' },
+    current: null,
+    elapsed: 0,
+    error: '',
+    finished: false,
+    libraryIndex: 0,
+    librarySongs: [],
+    loading: false,
+    next: null,
+    preparing: false,
+    savingId: '',
+    seen: [],
+    serverId: '',
+};
+export const useDiscoveryRadio = create<DiscoveryRadioState>(() => initialState);
+let generation = 0;
+let pending: null | Promise<null | PreparedRadioTrack> = null;
+
+export const abandonDiscoveryRadio = () => {
+    generation += 1;
+    pending = null;
+    useDiscoveryRadio.setState(initialState);
+};
+
+export const stopDiscoveryRadio = () => {
+    abandonDiscoveryRadio();
+    useRadioStore.getState().actions.stop();
+};
+
+export const discoveryLabel = (context: DiscoveryContext) =>
+    context.listening === 'library'
+        ? 'Solo playlist'
+        : context.listening === 'mix'
+          ? 'Mix'
+          : 'Nuova musica';
+
+const prepareLibraryTrack = async (
+    state: DiscoveryRadioState,
+): Promise<null | PreparedRadioTrack> => {
+    const song = state.librarySongs[state.libraryIndex];
+    if (!song) return null;
+    const audioUrl = await api.controller.getStreamUrl({
+        apiClientProps: { serverId: state.serverId },
+        query: { id: song.id, transcode: false },
+    });
+    return {
+        audio_url: audioUrl,
+        context_label: state.context.label,
+        duration: Math.max(1, song.duration || 1),
+        libraryIndex: state.libraryIndex,
+        track: {
+            artist: song.artistName || 'Artista sconosciuto',
+            error: '',
+            id: song.id,
+            reason: 'Dalla tua playlist',
+            song_id: song.id,
+            status: 'ready',
+            title: song.name,
+        },
+    };
+};
+
+const prepareNext = (): Promise<null | PreparedRadioTrack> => {
+    if (pending) return pending;
+    const state = useDiscoveryRadio.getState();
+    if (!state.active) return Promise.resolve(null);
+    if (state.next) return Promise.resolve(state.next);
+    const requestGeneration = generation;
+    useDiscoveryRadio.setState({ preparing: true });
+    const library =
+        state.context.listening === 'library' ||
+        (state.context.listening === 'mix' && state.current?.libraryIndex === undefined);
+    const request = library
+        ? prepareLibraryTrack(
+              state.context.listening === 'mix' && state.libraryIndex >= state.librarySongs.length
+                  ? { ...state, libraryIndex: 0 }
+                  : state,
+          )
+        : api.musica.discoveryRadio(state.serverId, {
+              context: { mode: state.context.mode, value: state.context.value },
+              exclude: state.seen.slice(-80),
+              last_artist: state.current?.track.artist || '',
+          });
+    pending = request
+        .then((response) => {
+            if (generation !== requestGeneration) return null;
+            useDiscoveryRadio.setState({ next: response });
+            return response;
+        })
+        .catch((failure: unknown) => {
+            if (generation === requestGeneration) {
+                useDiscoveryRadio.setState({
+                    error:
+                        failure instanceof Error
+                            ? failure.message
+                            : 'Radio non disponibile. Riprova.',
+                });
+            }
+            return null;
+        })
+        .finally(() => {
+            if (generation === requestGeneration) {
+                pending = null;
+                useDiscoveryRadio.setState({ preparing: false });
+            }
+        });
+    return pending;
+};
+
+const playPrepared = (prepared: PreparedRadioTrack, autoplay: boolean) => {
+    const state = useDiscoveryRadio.getState();
+    useDiscoveryRadio.setState({
+        current: prepared,
+        elapsed: 0,
+        error: '',
+        finished: false,
+        libraryIndex:
+            prepared.libraryIndex === undefined ? state.libraryIndex : prepared.libraryIndex + 1,
+        next: null,
+        seen:
+            prepared.libraryIndex === undefined
+                ? [...state.seen, prepared.track.id].slice(-80)
+                : state.seen,
+    });
+    const radio = useRadioStore.getState().actions;
+    radio.play(
+        prepared.audio_url,
+        `${discoveryLabel(state.context)} · ${prepared.context_label || state.context.label}`,
+        null,
+        true,
+    );
+    radio.setMetadata({ artist: prepared.track.artist, title: prepared.track.title });
+    if (!autoplay) radio.pause();
+    useDiscoveryRadio.setState({ loading: false });
+    void prepareNext();
+};
+
+export const nextDiscoveryTrack = async () => {
+    const state = useDiscoveryRadio.getState();
+    if (!state.active || state.loading || state.finished) return;
+    const requestGeneration = generation;
+    useDiscoveryRadio.setState({ error: '', loading: true });
+    const prepared = await prepareNext();
+    if (generation !== requestGeneration) return;
+    if (prepared) {
+        playPrepared(prepared, !state.current || useRadioStore.getState().isPlaying);
+    } else {
+        useDiscoveryRadio.setState({
+            finished:
+                state.context.listening === 'library' &&
+                state.libraryIndex >= state.librarySongs.length,
+            loading: false,
+        });
+        useRadioStore.getState().actions.pause();
+    }
+};
+
+export const startDiscoveryRadio = async (
+    serverId: string,
+    context: DiscoveryContext = initialState.context,
+) => {
+    stopDiscoveryRadio();
+    useDiscoveryRadio.setState({ active: true, context, serverId });
+    if (context.mode === 'playlist' && context.listening && context.listening !== 'discovery') {
+        const requestGeneration = generation;
+        useDiscoveryRadio.setState({ loading: true });
+        try {
+            const response = await api.controller.getPlaylistSongList({
+                apiClientProps: { serverId },
+                query: { id: context.value },
+            });
+            if (generation !== requestGeneration) return;
+            if (!response.items.length)
+                throw new Error('La playlist è vuota. Aggiungi almeno un brano.');
+            useDiscoveryRadio.setState({ librarySongs: response.items, loading: false });
+        } catch (failure) {
+            if (generation === requestGeneration)
+                useDiscoveryRadio.setState({
+                    error:
+                        failure instanceof Error
+                            ? failure.message
+                            : 'Non riesco a caricare la playlist. Riprova.',
+                    loading: false,
+                });
+            return;
+        }
+    }
+    await nextDiscoveryTrack();
+};
+
+export const saveCurrentDiscovery = async () => {
+    const { current, serverId } = useDiscoveryRadio.getState();
+    if (!current || current.libraryIndex !== undefined) return;
+    const id = current.track.id;
+    useDiscoveryRadio.setState({ savingId: id });
+    try {
+        await api.musica.saveDiscovery(serverId, id);
+        const state = useDiscoveryRadio.getState();
+        if (state.current?.track.id === id) {
+            useDiscoveryRadio.setState({
+                current: { ...state.current, track: { ...state.current.track, status: 'queued' } },
+            });
+        }
+    } catch (failure) {
+        const message =
+            failure instanceof Error ? failure.message : 'Salvataggio non riuscito. Riprova.';
+        const state = useDiscoveryRadio.getState();
+        if (state.current?.track.id === id) {
+            useDiscoveryRadio.setState({
+                current: {
+                    ...state.current,
+                    track: { ...state.current.track, error: message, status: 'failed' },
+                },
+            });
+        } else {
+            useDiscoveryRadio.setState({
+                error: `Non salvato: ${current.track.title}. ${message}`,
+            });
+        }
+    } finally {
+        if (useDiscoveryRadio.getState().savingId === id)
+            useDiscoveryRadio.setState({ savingId: '' });
+    }
+};
