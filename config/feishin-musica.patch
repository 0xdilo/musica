+import { usePlayer } from '/@/renderer/features/player/context/player-context';
+import { Button } from '/@/shared/components/button/button';
+import { Select } from '/@/shared/components/select/select';
+import { TextInput } from '/@/shared/components/text-input/text-input';
+import { LibraryItem } from '/@/shared/types/domain-types';
+import { Play } from '/@/shared/types/types';
+
+const modes = [
+    { label: 'Per te', mode: 'personal' },
+    { label: 'Genere', mode: 'genre' },
+    { label: 'Preferiti', mode: 'favourites' },
+    { label: 'Playlist', mode: 'playlist' },
+] as const;
+const genres = [
+    'Punk',
+    'Post-punk',
+    'Hardcore punk',
+    'Indie rock',
+    'Metal',
+    'Hip hop',
+    'Electronic',
+    'Ambient',
+];
+
+export const NewMusic = ({ serverId }: { serverId: string }) => {
+    const state = useDiscoveryRadio();
+    const player = usePlayer();
+    const [mode, setMode] = useState<DiscoveryContext['mode']>(
+        state.active ? state.context.mode : 'personal',
+    );
+    const [listening, setListening] = useState<ListeningMode>(
+        state.context.listening || 'discovery',
+    );
+    const [genre, setGenre] = useState(state.context.mode === 'genre' ? state.context.value : '');
+    const [playlistId, setPlaylistId] = useState<null | string>(
+        state.context.mode === 'playlist' ? state.context.value : null,
+    );
+    const options = useQuery({
+        enabled: mode === 'playlist',
+        queryFn: () => api.musica.discoveryOptions(serverId),
+        queryKey: ['discovery-radio-options', serverId],
+        staleTime: 0,
+    });
+    const saves = useQuery({
+        queryFn: () => api.musica.savedDiscoveries(serverId),
+        queryKey: ['new-music-saves', serverId],
+        refetchInterval: 10000,
+    });
+    const selectedPlaylist = options.data?.playlists.find((p) => p.id === playlistId);
+    const target: DiscoveryContext = {
+        label:
+            mode === 'genre'
+                ? genre.trim()
+                : mode === 'playlist'
+                  ? selectedPlaylist?.name || 'Playlist'
+                  : mode === 'favourites'
+                    ? 'Preferiti'
+                    : 'Per te',
+        listening: mode === 'playlist' ? listening : 'discovery',
+        mode,
+        value:
+            mode === 'genre'
+                ? genre.trim().toLowerCase()
+                : mode === 'playlist'
+                  ? playlistId || ''
+                  : '',
+    };
+    const valid =
+        mode === 'genre'
+            ? genre.trim().length >= 2
+            : mode === 'playlist'
+              ? Boolean(selectedPlaylist?.count)
+              : true;
+    return (
+        <section aria-label="Scopri nuova musica" className={styles.newMusic}>
+            <div className={styles.radioForm}>
+                <Select
+                    allowDeselect={false}
+                    aria-label="Origine della nuova musica"
+                    data={modes.map((item) => ({ label: item.label, value: item.mode }))}
+                    label="Parti da"
+                    onChange={(value) => {
+                        const selected = modes.find((item) => item.mode === value);
+                        if (selected) setMode(selected.mode);
+                    }}
+                    value={mode}
+                />
+                {mode === 'genre' && (
+                    <TextInput
+                        aria-label="Genere della nuova musica"
+                        label="Genere"
+                        maxLength={120}
+                        onChange={(event) => setGenre(event.currentTarget.value)}
+                        onKeyDown={(event) => {
+                            if (event.key === 'Enter' && valid)
+                                void startDiscoveryRadio(serverId, target);
+                        }}
+                        placeholder="Punk, shoegaze, ambient…"
+                        value={genre}
+                    />
+                )}
+                {mode === 'playlist' && (
+                    <Select
+                        clearable
+                        data={
+                            options.data?.playlists.map((p) => ({
+                                label: `${p.name} · ${p.count} brani`,
+                                value: p.id,
+                            })) || []
+                        }
+                        label="Playlist di partenza"
+                        nothingFoundMessage="Nessuna playlist trovata"
+                        onChange={setPlaylistId}
+                        placeholder={options.isPending ? 'Caricamento…' : 'Scegli una playlist'}
+                        searchable
+                        value={playlistId}
+                    />
+                )}
+            </div>
+            {mode === 'genre' && (
+                <div aria-label="Generi rapidi" className={styles.quickGenres}>
+                    {genres.map((name) => (
+                        <Button
+                            key={name}
+                            onClick={() => {
+                                setGenre(name);
+                                void startDiscoveryRadio(serverId, {
+                                    label: name,
+                                    mode: 'genre',
+                                    value: name.toLowerCase(),
+                                });
+                            }}
+                            size="sm"
+                            variant="subtle"
+                        >
+                            {name}
+                        </Button>
+                    ))}
+                </div>
+            )}
+            <div className={styles.radioActions}>
+                <RadioSourceButton context={target} disabled={!valid} label="Riproduci" />
+                {mode === 'playlist' && (
+                    <ListeningChoices onChange={setListening} value={listening} />
+                )}
+                <span className={styles.hint}>
+                    {mode === 'playlist' && listening === 'library'
+                        ? 'Solo i brani della playlist.'
+                        : mode === 'playlist' && listening === 'mix'
+                          ? 'Playlist e nuove proposte alternate.'
+                          : 'Nuovi brani dalla selezione.'}
+                </span>
+            </div>
+            {mode === 'playlist' && options.isError && (
+                <p role="alert">
+                    Non riesco a caricare le playlist.{' '}
+                    <Button onClick={() => void options.refetch()} variant="subtle">
+                        Riprova
+                    </Button>
+                </p>
+            )}
+            {mode === 'playlist' && selectedPlaylist?.count === 0 && <p>La playlist è vuota.</p>}
+            {state.loading && (
+                <p role="status">
+                    {state.current ? 'Preparo il prossimo brano…' : 'Preparo il primo brano…'}
+                </p>
+            )}
+            {(state.current?.track.error || state.error) && (
+                <p role="alert">{state.current?.track.error || state.error}</p>
+            )}
+            <details className={styles.savedDiscoveries} open>
+                <summary>
+                    Salvati
+                    {saves.data?.tracks.length ? ` · ${saves.data.tracks.length}` : ''}
+                </summary>
+                {saves.isError && <p role="alert">Non riesco a caricare i salvataggi.</p>}
+                <ol className={styles.tracks}>
+                    {saves.data?.tracks.map((track) => (
+                        <li className={styles.track} key={track.id}>
+                            <button
+                                aria-label={`Ascolta ${track.title}`}
+                                className={styles.trackPlay}
+                                disabled={track.status !== 'ready' || !track.song_id}
+                                onClick={() =>
+                                    player.addToQueueByFetch(
+                                        serverId,
+                                        [track.song_id],
+                                        LibraryItem.SONG,
+                                        Play.NOW,
+                                        { skipConfirmation: true },
+                                    )
+                                }
+                                type="button"
+                            >
+                                <div className={styles.cover}>
+                                    <ItemImage
+                                        id={track.song_id || undefined}
+                                        itemType={LibraryItem.SONG}
+                                        serverId={serverId}
+                                        type="table"
+                                    />
+                                </div>
+                                <div className={styles.trackText}>
+                                    <strong>{track.title}</strong>
+                                    <span>{track.artist}</span>
+                                </div>
+                            </button>
+                            <span
+                                className={styles.savedStatus}
+                                role={track.status === 'failed' ? 'alert' : undefined}
+                            >
+                                {track.status === 'ready'
+                                    ? 'In libreria'
+                                    : track.status === 'failed'
+                                      ? track.error
+                                      : 'Salvataggio…'}
+                            </span>
+                        </li>
+                    ))}
+                </ol>
+                {saves.data?.tracks.length === 0 && <p>Non hai ancora salvato brani.</p>}
+            </details>
+        </section>
+    );
+};
