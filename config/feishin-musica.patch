+import { queryOptions } from '@tanstack/react-query';
+
+import { api } from '/@/renderer/api';
+import { type RadioRequest } from '/@/renderer/api/musica/schemas';
+import { queryKeys } from '/@/renderer/api/query-keys';
+
+export const exploreQueries = {
+    overview: (serverId: string) =>
+        queryOptions({
+            queryFn: ({ signal }) => api.musica.overview(serverId, signal),
+            queryKey: queryKeys.discovery.overview(serverId),
+            staleTime: 30_000,
+        }),
+};
+
+export const fetchRadio = async (serverId: string, data: RadioRequest, signal: AbortSignal) => {
+    const result = await api.musica.search(serverId, data, signal);
+    const songs = await Promise.all(
+        result.ids.map((id) =>
+            api.controller.getSongDetail({
+                apiClientProps: { serverId, signal },
+                query: { id },
+            }),
+        ),
+    );
+    return { ...result, songs };
+};
