diff --git a/src/renderer/api/musica/musica-controller.ts b/src/renderer/api/musica/musica-controller.ts
new file mode 100644
index 0000000..ea8348c
--- /dev/null
+++ b/src/renderer/api/musica/musica-controller.ts
@@ -0,0 +1,78 @@
+import z from 'zod';
+
+import {
+    acceptedSchema,
+    discoveriesSchema,
+    type DiscoveryContext,
+    discoveryOptionsSchema,
+    discoveryRadioSchema,
+    overviewSchema,
+    preferencesSchema,
+    previewSchema,
+    type RadioRequest,
+    radioSchema,
+} from './schemas';
+
+import { getServerById } from '/@/renderer/store';
+
+const request = async <T>(
+    serverId: string,
+    endpoint: string,
+    data: object,
+    schema: z.ZodType<T>,
+    signal?: AbortSignal,
+): Promise<T> => {
+    const token = getServerById(serverId)?.ndCredential;
+    if (!token) {
+        throw new Error('Accedi di nuovo a Musica per usare Esplora.');
+    }
+    const response = await fetch(`/api/discovery/${endpoint}`, {
+        body: JSON.stringify(data),
+        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+        method: 'POST',
+        signal,
+    }).catch((error: unknown) => {
+        if (error instanceof Error && error.name === 'AbortError') {
+            throw error;
+        }
+        throw new Error('Connessione non disponibile. Riprova tra poco.');
+    });
+    const body: unknown = await response.json().catch(() => null);
+    if (!response.ok) {
+        const error = z.object({ error: z.string() }).safeParse(body);
+        throw new Error(error.success ? error.data.error : 'Ricerca musicale non disponibile.');
+    }
+    const parsed = schema.safeParse(body);
+    if (!parsed.success) {
+        throw new Error('Risposta musicale non disponibile. Riprova tra poco.');
+    }
+    return parsed.data;
+};
+
+export const musicaController = {
+    discoveries: (serverId: string, refresh = false) =>
+        request(serverId, 'new-music', { refresh }, discoveriesSchema),
+    discoveryOptions: (serverId: string) =>
+        request(serverId, 'radio-options', {}, discoveryOptionsSchema),
+    discoveryRadio: (
+        serverId: string,
+        data: {
+            context: Pick<DiscoveryContext, 'mode' | 'value'>;
+            exclude: string[];
+            last_artist: string;
+        },
+    ) => request(serverId, 'new-radio', data, discoveryRadioSchema),
+    dismissDiscovery: (serverId: string, id: string) =>
+        request(serverId, 'dismiss', { id }, acceptedSchema),
+    feedback: (serverId: string, data: object) =>
+        request(serverId, 'feedback', data, preferencesSchema),
+    overview: (serverId: string, signal?: AbortSignal) =>
+        request(serverId, 'overview', {}, overviewSchema, signal),
+    previewDiscovery: (serverId: string, id: string) =>
+        request(serverId, 'preview', { id }, previewSchema),
+    savedDiscoveries: (serverId: string) => request(serverId, 'saves', {}, discoveriesSchema),
+    saveDiscovery: (serverId: string, id: string) =>
+        request(serverId, 'save', { id }, acceptedSchema),
+    search: (serverId: string, data: RadioRequest, signal?: AbortSignal) =>
+        request(serverId, 'search', data, radioSchema, signal),
+};
diff --git a/src/renderer/api/musica/schemas.ts b/src/renderer/api/musica/schemas.ts
new file mode 100644
index 0000000..98c7c96
--- /dev/null
+++ b/src/renderer/api/musica/schemas.ts
@@ -0,0 +1,65 @@
+import z from 'zod';
+
+export const preferencesSchema = z.object({
+    artists: z.record(z.string(), z.string()),
+    tracks: z.record(z.string(), z.string()),
+});
+
+export const overviewSchema = z.object({
+    favourites: z.number().int().nonnegative(),
+    genres: z.array(z.object({ count: z.number().int().positive(), name: z.string() })),
+    preferences: preferencesSchema,
+    songs: z.number().int().nonnegative(),
+});
+
+export const radioSchema = z.object({
+    description: z.string(),
+    ids: z.array(z.string().regex(/^[a-zA-Z0-9]{1,64}$/)).max(30),
+    pool: z.number().int().nonnegative(),
+    seed_id: z.string().nullable().optional(),
+});
+
+export type Preferences = z.infer<typeof preferencesSchema>;
+export const discoveryTrackSchema = z.object({
+    artist: z.string(),
+    error: z.string(),
+    id: z.string().regex(/^[a-f0-9]{32}$/),
+    reason: z.string(),
+    song_id: z.string(),
+    status: z.enum(['new', 'queued', 'matching', 'downloading', 'importing', 'ready', 'failed']),
+    title: z.string(),
+});
+export const discoveriesSchema = z.object({
+    message: z.string().optional(),
+    tracks: z.array(discoveryTrackSchema),
+});
+export const acceptedSchema = z.object({ accepted: z.boolean() });
+export const previewSchema = z.object({
+    audio_url: z.string().regex(/^\/preview\/[a-f0-9]{32}\/\d{10}\/[a-f0-9]{64}\.mp3$/),
+});
+export const discoveryRadioSchema = previewSchema.extend({
+    context_label: z.string().optional(),
+    duration: z.number().positive(),
+    track: discoveryTrackSchema,
+});
+export type DiscoveryContext = {
+    label: string;
+    listening?: ListeningMode;
+    mode: 'favourites' | 'genre' | 'personal' | 'playlist';
+    value: string;
+};
+export type DiscoveryRadioTrack = z.infer<typeof discoveryRadioSchema>;
+export type ListeningMode = 'discovery' | 'library' | 'mix';
+export const discoveryOptionsSchema = z.object({
+    playlists: z.array(
+        z.object({ count: z.number().int().nonnegative(), id: z.string(), name: z.string() }),
+    ),
+});
+export type DiscoveryTrack = z.infer<typeof discoveryTrackSchema>;
+export type RadioRequest = {
+    avoid_recent: boolean;
+    mode: 'forgotten' | 'genre' | 'personal' | 'text' | 'track';
+    query: string;
+    variation: string;
+    variety: 'focused' | 'varied';
+};
