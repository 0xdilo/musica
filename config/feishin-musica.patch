diff --git a/scripts/snapshot-presets.ts b/scripts/snapshot-presets.ts
new file mode 100644
index 0000000..5161442
--- /dev/null
+++ b/scripts/snapshot-presets.ts
@@ -0,0 +1,20 @@
+// The preset package ships large executable bundles containing JSON data.
+// Keep its presets as lazy JSON chunks; no eval or separate WASM parser is needed.
+import base from 'butterchurn-presets/dist/base.js';
+import extra from 'butterchurn-presets/dist/extra.js';
+import md1 from 'butterchurn-presets/dist/md1.js';
+
+const entries = Object.entries({ ...base, ...extra, ...md1 });
+for (let offset = 0; offset < entries.length; offset += 15) {
+    const data = Object.fromEntries(entries.slice(offset, offset + 15));
+    const serialized = JSON.stringify(data, (_key, value) => {
+        if (typeof value === 'function') {
+            throw new Error('Preset package now contains functions; review the snapshot format.');
+        }
+        return value;
+    });
+    await Bun.write(
+        new URL(`../src/renderer/features/visualizer/presets/${offset}.json`, import.meta.url),
+        serialized + '\n',
+    );
+}
