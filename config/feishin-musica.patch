+                                                descrizione più ampia o disattiva il filtro delle
+                                                ultime 24 ore.
+                                            </p>
+                                        )}
+                                        {lastRequest && (
+                                            <Button
+                                                onClick={() =>
+                                                    void search(lastRequest.mode, lastRequest.query)
+                                                }
+                                                variant="subtle"
+                                            >
+                                                Un altro giro
+                                            </Button>
+                                        )}
+                                        <ol className={styles.tracks}>
+                                            {result.songs.map((song, index) => (
