+                                                        variant="subtle"
+                                                    >
+                                                        Ripristina
+                                                    </Button>
+                                                </div>
+                                            )),
+                                        )}
+                                    </details>
+                                )}
+                        </Tabs.Panel>
+                    </Tabs>
+                </Stack>
+            </NativeScrollArea>
+        </AnimatedPage>
+    );
+};
+
+export default ExploreRoute;
