+import { useQuery } from '@tanstack/react-query';
+import { useEffect, useRef, useState } from 'react';
+import { generatePath, Link } from 'react-router';
+
+import { exploreQueries, fetchRadio } from './explore-api';
+import styles from './explore.module.css';
+import { NewMusic } from './new-music';
+
+import { api } from '/@/renderer/api';
+import { type Preferences, type RadioRequest } from '/@/renderer/api/musica/schemas';
+import { ItemImage } from '/@/renderer/components/item-image/item-image';
+import { NativeScrollArea } from '/@/renderer/components/native-scroll-area/native-scroll-area';
+import { usePlayer } from '/@/renderer/features/player/context/player-context';
+import { AnimatedPage } from '/@/renderer/features/shared/components/animated-page';
+import { AppRoute } from '/@/renderer/router/routes';
+import { useCurrentServerId } from '/@/renderer/store';
+import { ActionIcon } from '/@/shared/components/action-icon/action-icon';
+import { Button } from '/@/shared/components/button/button';
+import { Group } from '/@/shared/components/group/group';
+import { Icon } from '/@/shared/components/icon/icon';
+import { Select } from '/@/shared/components/select/select';
+import { Stack } from '/@/shared/components/stack/stack';
+import { Tabs } from '/@/shared/components/tabs/tabs';
+import { TextInput } from '/@/shared/components/text-input/text-input';
+import { LibraryItem, type Song } from '/@/shared/types/domain-types';
+import { Play } from '/@/shared/types/types';
+
+const ExploreRoute = () => {
+    const serverId = useCurrentServerId() || '';
+    const player = usePlayer();
+    const overview = useQuery(exploreQueries.overview(serverId));
+    const [query, setQuery] = useState('');
+    const [variety, setVariety] = useState<RadioRequest['variety']>('focused');
+    const [avoidRecent, setAvoidRecent] = useState(true);
+    const [loading, setLoading] = useState(false);
+    const [error, setError] = useState('');
+    const [result, setResult] = useState<Awaited<ReturnType<typeof fetchRadio>> | null>(null);
+    const [lastRequest, setLastRequest] = useState<null | {
+        mode: RadioRequest['mode'];
+        query: string;
+    }>(null);
+    const [preferences, setPreferences] = useState<null | Preferences>(null);
+    const [feedbackPending, setFeedbackPending] = useState(false);
+    const request = useRef<AbortController | null>(null);
+    const resultRef = useRef<HTMLElement>(null);
+
+    useEffect(() => () => request.current?.abort(), []);
+
+    const search = async (mode: RadioRequest['mode'], text = query) => {
+        request.current?.abort();
+        const controller = new AbortController();
+        request.current = controller;
+        setLoading(true);
+        setError('');
+        setResult(null);
+        setLastRequest({ mode, query: text });
+        try {
+            const response = await fetchRadio(
+                serverId,
+                {
+                    avoid_recent: avoidRecent,
+                    mode,
+                    query: text,
+                    variation: crypto.randomUUID(),
+                    variety,
+                },
+                controller.signal,
+            );
+            if (!controller.signal.aborted) {
+                setResult(response);
+                window.setTimeout(
+                    () => resultRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' }),
+                    50,
+                );
+            }
+        } catch (failure) {
+            if (!controller.signal.aborted) {
+                setError(
+                    failure instanceof Error ? failure.message : 'Ricerca non riuscita. Riprova.',
+                );
+            }
+        } finally {
+            if (!controller.signal.aborted) {
+                setLoading(false);
+            }
+        }
+    };
+
+    const exclude = async (kind: 'artists' | 'tracks', song: Song) => {
+        setFeedbackPending(true);
+        try {
+            setPreferences(await api.musica.feedback(serverId, { id: song.id, kind }));
+            setResult((current) =>
+                current
+                    ? {
+                          ...current,
+                          songs: current.songs.filter((item) =>
+                              kind === 'tracks'
+                                  ? item.id !== song.id
+                                  : item.artistName !== song.artistName,
+                          ),
+                      }
+                    : current,
+            );
+        } catch (failure) {
+            setError(
+                failure instanceof Error ? failure.message : 'Preferenza non salvata. Riprova.',
+            );
+        } finally {
+            setFeedbackPending(false);
+        }
+    };
+
+    const restore = async (kind: 'artists' | 'tracks', key: string) => {
+        setFeedbackPending(true);
+        try {
+            setPreferences(await api.musica.feedback(serverId, { key, kind, remove: true }));
+        } catch (failure) {
+            setError(
+                failure instanceof Error ? failure.message : 'Preferenza non salvata. Riprova.',
+            );
+        } finally {
+            setFeedbackPending(false);
+        }
+    };
+
+    const exclusions = preferences || overview.data?.preferences;
+    const play = (songs: Song[], type = Play.NOW) =>
+        player.addToQueueByData(songs, type, undefined, undefined, true);
+
+    return (
+        <AnimatedPage>
+            <NativeScrollArea noHeader>
+                <Stack className={styles.page} gap="md">
