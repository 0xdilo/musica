# Keep this service on loopback, behind your private HTTPS proxy.
MUSICA_CAPTURE_PORT=9181
MUSICA_CAPTURE_PUBLIC_URL=https://your-private-host.example
MUSICA_LIBRARY_PUBLIC_URL=https://your-navidrome-host.example
NAVIDROME_URL=http://127.0.0.1:4533
# Optional. A random token is generated here with mode 0600 on first start.
# MUSICA_CAPTURE_TOKEN_FILE=/path/to/protected/state/capture/token

# Native discovery stations: temporary previews, MP3/ICY streaming and two buffered tracks.
# Enable, then create stations from the private companion page.
MUSICA_NATIVE_RADIOS=false
